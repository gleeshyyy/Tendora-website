{
  "name": "tendora",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tendora-admin",
      "database_id": "7bbdea05-d5c5-41f5-badd-bf74d38aab76"
    }
  ],
  "triggers": { "crons": ["15 * * * *"] },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
